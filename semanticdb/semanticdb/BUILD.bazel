load("//:cross_scala.bzl", "scala_cross_library")

# SemanticDB library
# Note: The protobuf-generated Scala files should be generated by sbt first,
# then we can build them with Bazel
scala_cross_library(
    name = "semanticdb",
    srcs = glob([
        "src/main/scala/**/*.scala",
        "jvm/target/scala-2.13/src_managed/**/*.scala",  # Generated protobuf files
    ]),
    deps = [
        "@maven//:com_thesamet_scalapb_scalapb_runtime_2_13",
        "@maven//:com_google_protobuf_protobuf_java",
    ],
    visibility = ["//visibility:public"],
)
